# ===========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ===========================================

# Database Configuration
# CRITICAL: Use PostgreSQL or MySQL in production, NOT SQLite
# SQLite: sqlite:///database.db (DEVELOPMENT ONLY)
# PostgreSQL: postgresql://user:password@host:5432/dbname
# MySQL: mysql://user:password@host:3306/dbname
DATABASE_URL=sqlite:///database.db

# Security Keys (CRITICAL: Generate new keys for production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-this
JWT_SECRET_KEY=your-jwt-secret-key-here-change-this

# Application Mode
# CRITICAL: Set to False in production
DEBUG=False

# CORS Configuration
# CRITICAL: Set to your production domain(s)
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Admin User (Optional - for initial setup)
# IMPORTANT: Only set these if you want to create an admin user automatically
# Otherwise, use: python create_admin.py
# ADMIN_EMAIL=your-admin@example.com
# ADMIN_PASSWORD=YourSecurePassword123!
# ADMIN_NAME=Admin User

# Rate Limiting (Optional - Redis for production)
# REDIS_URL=redis://localhost:6379
